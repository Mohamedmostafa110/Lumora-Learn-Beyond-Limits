@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Taxonomy & Coupons Governance";
    ViewData["TopbarTitle"] = "Taxonomy, Tags & Commercial Discount Governance";
}

<main class="dashboard-content">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <h2 class="h3 fw-bold text-lumora-midnight mb-1 font-heading">Taxonomy &amp; Promotional Engine Governance</h2>
      <p class="text-muted small mb-0">Control architectural discipline categories, search indexing tags, and enterprise discount coupon rules.</p>
    </div>
    <button type="button" class="btn btn-cta btn-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
      <i class="bi bi-plus-circle me-1"></i>New Category Track
    </button>
  </div>

  <div class="row g-4">
    <!-- Left Column: Categories & Skill Tags (6 Cols) -->
    <div class="col-lg-6">
      <!-- Categories Table -->
      <div class="card p-4 border-lumora-subtle bg-white shadow-sm mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-lumora-subtle">
          <h5 class="fw-bold text-lumora-midnight mb-0 font-heading">
            <i class="bi bi-grid-fill text-lumora-champagne-dark me-2"></i>Architectural Disciplines (6 Tracks)
          </h5>
        </div>

        <div class="table-responsive">
          <table class="table table-sm align-middle small">
            <thead>
              <tr>
                <th>Track Name</th>
                <th>Slug</th>
                <th>Courses</th>
                <th class="text-end">Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong class="text-lumora-midnight font-heading">Cloud &amp; Distributed Systems</strong></td>
                <td><code>/cloud</code></td>
                <td><strong>38</strong></td>
                <td class="text-end"><span class="badge badge-gold">ACTIVE</span></td>
              </tr>
              <tr>
                <td><strong class="text-lumora-midnight font-heading">Enterprise .NET &amp; C#</strong></td>
                <td><code>/dotnet</code></td>
                <td><strong>32</strong></td>
                <td class="text-end"><span class="badge badge-gold">ACTIVE</span></td>
              </tr>
              <tr>
                <td><strong class="text-lumora-midnight font-heading">AI &amp; LLM Engineering</strong></td>
                <td><code>/ai</code></td>
                <td><strong>28</strong></td>
                <td class="text-end"><span class="badge badge-gold">ACTIVE</span></td>
              </tr>
              <tr>
                <td><strong class="text-lumora-midnight font-heading">Cybersecurity &amp; Zero-Trust</strong></td>
                <td><code>/security</code></td>
                <td><strong>24</strong></td>
                <td class="text-end"><span class="badge badge-gold">ACTIVE</span></td>
              </tr>
              <tr>
                <td><strong class="text-lumora-midnight font-heading">DevOps, K8s &amp; SRE</strong></td>
                <td><code>/devops</code></td>
                <td><strong>20</strong></td>
                <td class="text-end"><span class="badge badge-gold">ACTIVE</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Skill Tags Cloud Manager -->
      <div class="card p-4 border-lumora-subtle bg-white shadow-sm">
        <h5 class="fw-bold text-lumora-midnight mb-2 font-heading">
          <i class="bi bi-tags text-lumora-champagne-dark me-2"></i>Search Indexing &amp; Skill Tags
        </h5>
        <p class="small text-muted mb-3">Managed architectural tags applied across curriculum search queries and search suggestions.</p>

        <div class="d-flex flex-wrap gap-2 mb-3">
          <span class="badge badge-navy">#distributed-systems <i class="bi bi-x cursor-pointer ms-1"></i></span>
          <span class="badge badge-navy">#csharp <i class="bi bi-x cursor-pointer ms-1"></i></span>
          <span class="badge badge-navy">#cqrs <i class="bi bi-x cursor-pointer ms-1"></i></span>
          <span class="badge badge-navy">#kafka-replay <i class="bi bi-x cursor-pointer ms-1"></i></span>
          <span class="badge badge-navy">#zero-trust <i class="bi bi-x cursor-pointer ms-1"></i></span>
          <span class="badge badge-navy">#ebpf-cilium <i class="bi bi-x cursor-pointer ms-1"></i></span>
          <span class="badge badge-navy">#mediatr <i class="bi bi-x cursor-pointer ms-1"></i></span>
          <span class="badge badge-navy">#redis-cache <i class="bi bi-x cursor-pointer ms-1"></i></span>
          <span class="badge badge-navy">#kubernetes-gitops <i class="bi bi-x cursor-pointer ms-1"></i></span>
        </div>

        <form class="d-flex gap-2" onsubmit="event.preventDefault(); LumoraToast('Tag added to platform search indexing.');">
          <input type="text" class="form-control form-control-sm" placeholder="Add new skill tag (e.g. #azure-frontdoor)" required />
          <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">+ Add Tag</button>
        </form>
      </div>
    </div>

    <!-- Right Column: Coupons & Discounts (6 Cols) -->
    <div class="col-lg-6">
      <!-- Active Coupons List -->
      <div class="card p-4 border-lumora-subtle bg-white shadow-sm mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-lumora-subtle">
          <h5 class="fw-bold text-lumora-midnight mb-0 font-heading">
            <i class="bi bi-percent text-lumora-champagne-dark me-2"></i>Active Promotional Vouchers
          </h5>
        </div>

        <div class="d-flex flex-column gap-2 mb-3">
          <!-- Coupon 1 -->
          <div class="p-3 bg-lumora-ivory rounded-3 border-lumora-subtle d-flex justify-content-between align-items-center">
            <div>
              <div class="d-flex align-items-center gap-2 mb-1">
                <code class="fw-bold text-lumora-midnight fs-6">LUMORA-ENTERPRISE-20</code>
                <span class="badge badge-gold">20% OFF</span>
              </div>
              <small class="text-muted">Expires Dec 31, 2026 &bull; 420 used of 1,000</small>
            </div>
            <span class="badge badge-gold">ACTIVE</span>
          </div>

          <!-- Coupon 2 -->
          <div class="p-3 bg-lumora-ivory rounded-3 border-lumora-subtle d-flex justify-content-between align-items-center">
            <div>
              <div class="d-flex align-items-center gap-2 mb-1">
                <code class="fw-bold text-lumora-midnight fs-6">BLACKFRIDAY-ARCH-30</code>
                <span class="badge badge-gold">30% OFF</span>
              </div>
              <small class="text-muted">Expires Nov 30, 2026 &bull; 150 used of 500</small>
            </div>
            <span class="badge badge-gold">ACTIVE</span>
          </div>

          <!-- Coupon 3 -->
          <div class="p-3 bg-lumora-ivory rounded-3 border-lumora-subtle d-flex justify-content-between align-items-center">
            <div>
              <div class="d-flex align-items-center gap-2 mb-1">
                <code class="fw-bold text-muted fs-6">SUMMER-15</code>
                <span class="badge badge-slate">15% OFF</span>
              </div>
              <small class="text-muted">Expired Sep 01, 2026 &bull; 850 used</small>
            </div>
            <span class="badge badge-slate">EXPIRED</span>
          </div>
        </div>
      </div>

      <!-- Create New Coupon Form -->
      <div class="card p-4 border-lumora-subtle bg-white shadow-sm">
        <h5 class="fw-bold text-lumora-midnight mb-2 font-heading">Configure New Promotional Voucher</h5>
        <p class="small text-muted mb-3">Deploy automated discount codes with cryptographic usage caps.</p>

        <form onsubmit="event.preventDefault(); LumoraToast('Promotional voucher generated and deployed to checkout engine!'); this.reset();">
          <div class="mb-3">
            <label class="form-label">Voucher Hash Code</label>
            <input type="text" class="form-control form-control-sm text-uppercase" placeholder="e.g. ENTERPRISE-LEAD-25" required />
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label">Discount Percentage (%)</label>
              <div class="input-group input-group-sm">
                <input type="number" class="form-control" placeholder="25" min="5" max="80" required />
                <span class="input-group-text bg-white">%</span>
              </div>
            </div>
            <div class="col-6">
              <label class="form-label">Max Usage Limit</label>
              <input type="number" class="form-control form-control-sm" placeholder="500" required />
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Expiration Date</label>
            <input type="date" class="form-control form-control-sm" required />
          </div>

          <button type="submit" class="btn btn-cta btn-sm w-100">
            <i class="bi bi-check2-circle me-1"></i>Deploy Promotional Voucher
          </button>
        </form>
      </div>
    </div>
  </div>
</main>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold text-lumora-midnight font-heading">Add Architectural Discipline Track</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form onsubmit="event.preventDefault(); bootstrap.Modal.getInstance(document.getElementById('addCategoryModal')).hide(); LumoraToast('New category track registered successfully!');">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label">Track Name</label>
            <input type="text" class="form-control" placeholder="e.g. Embedded &amp; Edge Systems" required />
          </div>
          <div class="mb-3">
            <label class="form-label">URL Slug</label>
            <input type="text" class="form-control" placeholder="e.g. /edge-systems" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Track Overview Summary</label>
            <textarea class="form-control" rows="3" placeholder="Brief explanation of architectural competencies covered..." required></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-primary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-cta btn-sm">Create Track</button>
        </div>
      </form>
    </div>
  </div>
</div>