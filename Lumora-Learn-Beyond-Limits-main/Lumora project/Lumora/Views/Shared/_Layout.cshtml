<!DOCTYPE html>
<html lang="en" dir="ltr" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lumora | Learn Beyond Limits</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-body: #0b1120;
            --bg-card: #151e32;
            --bg-card-alt: #1a253c;
            --border-color: rgba(255, 255, 255, 0.1);
            --text-main: #ffffff;
            --text-secondary: #cbd5e1;
            --text-muted: #94a3b8;
            --primary: #6366f1;
            --primary-hover: #4f46e5;
        }

        [data-theme="light"] {
            --bg-body: #f8fafc;
            --bg-card: #ffffff;
            --bg-card-alt: #f1f5f9;
            --border-color: #e2e8f0;
            --text-main: #0f172a;
            --text-secondary: #334155;
            --text-muted: #64748b;
            --primary: #4f46e5;
            --primary-hover: #4338ca;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-custom {
            background-color: var(--bg-card);
            border-bottom: 1px solid var(--border-color);
        }

        .card-custom {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
        }

        .theme-toggle-btn {
            background-color: var(--bg-card-alt);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 6px 12px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom py-3 sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4 text-decoration-none" href="/" style="color: var(--text-main);">
                <span class="p-2 rounded-3 bg-primary text-white d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="bi bi-mortarboard-fill"></i>
                </span>
                <span>Lumora</span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 fw-normal px-2 py-1 ms-1">Learn Beyond Limits</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto ms-4 mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" style="color: var(--text-secondary);" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" style="color: var(--text-secondary);" href="/Catalog">Courses Catalog</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" style="color: var(--text-secondary);" href="/Verification">Verify Certificate</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="theme-toggle-btn" onclick="toggleTheme()">
                        <i class="bi bi-sun-fill" id="themeIcon"></i>
                    </button>
                    <a href="/Student/Dashboard" class="btn btn-outline-primary btn-sm px-3 fw-semibold">Student Portal</a>
                    <a href="/Instructor/Dashboard" class="btn btn-outline-success btn-sm px-3 fw-semibold">Instructor Studio</a>
                    <a href="/Admin/CourseApprovals" class="btn btn-outline-info btn-sm px-3 fw-semibold">Admin Desk</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="py-4 text-center mt-auto" style="background-color: var(--bg-card); border-top: 1px solid var(--border-color);">
        <div class="container text-muted small">
            <p class="mb-1"><strong>Lumora</strong> — Learn Beyond Limits &copy; @DateTime.UtcNow.Year. All Rights Reserved.</p>
            <p class="mb-0">Built with ASP.NET Core &amp; EF Core 10 | Clean N-Tier Architecture</p>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function setTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('lumora-theme', theme);
            const icon = document.getElementById('themeIcon');
            if (icon) {
                icon.className = theme === 'light' ? 'bi bi-moon-stars-fill' : 'bi bi-sun-fill';
            }
        }
        function toggleTheme() {
            const current = document.documentElement.getAttribute('data-theme') || 'dark';
            setTheme(current === 'dark' ? 'light' : 'dark');
        }
        setTheme(localStorage.getItem('lumora-theme') || 'dark');
    </script>
</body>
</html>
