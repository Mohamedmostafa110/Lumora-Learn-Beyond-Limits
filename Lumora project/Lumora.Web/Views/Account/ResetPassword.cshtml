@model ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="mb-4">
    <a asp-action="Login" class="small fw-bold text-lumora-slate d-inline-flex align-items-center mb-3">
        <i class="bi bi-arrow-left me-1"></i>Back to Sign In
    </a>
    <h3 class="fw-bold text-lumora-midnight mb-1 font-heading">Set New Password</h3>
    <p class="text-muted small mb-0">Choose a strong password to regain access to your Lumora account.</p>
</div>

<form asp-controller="Account" asp-action="ResetPassword" method="post" id="resetPasswordForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <div class="password-toggle-wrapper">
            <input asp-for="NewPassword" class="form-control pe-5" placeholder="Minimum 8 characters" required />
            <button type="button" class="password-toggle-btn" title="Toggle password view">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <small class="text-muted" style="font-size: 0.76rem;">Must contain uppercase, lowercase, number, and special character.</small>
        <span asp-validation-for="NewPassword" class="text-danger small d-block"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <div class="password-toggle-wrapper">
            <input asp-for="ConfirmPassword" class="form-control pe-5" placeholder="Confirm your new password" required />
            <button type="button" class="password-toggle-btn" title="Toggle password view">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-cta w-100 py-2 mb-3">
        <i class="bi bi-shield-lock-fill me-2"></i>Update Password
    </button>
</form>
