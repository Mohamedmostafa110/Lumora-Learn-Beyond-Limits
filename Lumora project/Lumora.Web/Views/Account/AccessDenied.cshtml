@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Access Denied";
}

<div class="text-center py-3">
    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-lumora-ivory border-lumora-subtle mb-3" style="width: 64px; height: 64px;">
        <i class="bi bi-shield-exclamation fs-2 text-danger"></i>
    </div>
    <h3 class="fw-bold text-lumora-midnight mb-2 font-heading">Access Restricted</h3>
    <p class="text-muted small mb-4">
        Your current account role does not have permission to open this resource.
    </p>

    <div class="d-flex flex-column gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-cta w-100 py-2">
            <i class="bi bi-house-door me-2"></i>Return to Home
        </a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary w-100 py-2">
            <i class="bi bi-box-arrow-in-right me-2"></i>Switch Account
        </a>
    </div>
</div>
