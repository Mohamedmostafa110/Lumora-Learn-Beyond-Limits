@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="mb-4">
    <a asp-action="Login" class="small fw-bold text-lumora-slate d-inline-flex align-items-center mb-3">
        <i class="bi bi-arrow-left me-1"></i>Back to Sign In
    </a>
    <h3 class="fw-bold text-lumora-midnight mb-1 font-heading">Forgot Password?</h3>
    <p class="text-muted small mb-0">Enter your registered email address and we'll send you an encrypted password reset link.</p>
</div>

@if (ViewBag.ResetSent == true)
{
    <div class="p-3 bg-lumora-ivory rounded-3 border-lumora-subtle mb-4 text-lumora-midnight" role="alert">
        <div class="d-flex gap-2 align-items-start">
            <i class="bi bi-check-circle-fill text-lumora-champagne-dark fs-5"></i>
            <div class="small">
                <strong>Check your inbox!</strong> If an account matches this email, a reset link has been generated.
                @if (ViewBag.DevResetLink != null)
                {
                    <div class="mt-2 pt-2 border-top border-lumora-subtle">
                        <span class="text-muted d-block mb-1">Development Preview Link:</span>
                        <a href="@ViewBag.DevResetLink" class="fw-bold text-lumora-midnight text-break">Reset Password Now</a>
                    </div>
                }
            </div>
        </div>
    </div>
}

<form asp-controller="Account" asp-action="ForgotPassword" method="post" id="forgotPasswordForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <!-- Email Input -->
    <div class="mb-4">
        <label asp-for="Email" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text bg-white border-lumora-subtle text-lumora-slate">
                <i class="bi bi-envelope"></i>
            </span>
            <input asp-for="Email" class="form-control" placeholder="name@company.com" required />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <!-- Submit Button -->
    <button type="submit" class="btn btn-cta w-100 py-2 mb-3">
        <i class="bi bi-send-fill me-2"></i>Send Reset Link
    </button>
</form>

<div class="p-3 bg-lumora-ivory rounded-3 border-lumora-subtle text-center small text-muted">
    Need enterprise SSO support? <a href="mailto:support@lumora.dev" class="fw-semibold text-lumora-midnight">Contact Security Team</a>
</div>
