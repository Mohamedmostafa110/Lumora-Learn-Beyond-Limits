@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In";
}

<div class="mb-4">
    <h3 class="fw-bold text-lumora-midnight mb-1 font-heading">Welcome Back</h3>
    <p class="text-muted small mb-0">Sign in to your account with your organization or personal email.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success py-2 px-3 mb-3 small" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
    </div>
}

<form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <!-- Email Input Field -->
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email Address</label>
        <div class="input-group">
            <span class="input-group-text bg-white border-lumora-subtle text-lumora-slate">
                <i class="bi bi-envelope"></i>
            </span>
            <input asp-for="Email" class="form-control" placeholder="name@company.com" value="" required />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <!-- Password Input Field with Toggle Visibility -->
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label asp-for="Password" class="form-label mb-0">Password</label>
            <a asp-action="ForgotPassword" class="small fw-semibold text-lumora-champagne-dark">Forgot Password?</a>
        </div>
        <div class="password-toggle-wrapper">
            <input asp-for="Password" class="form-control pe-5" placeholder="••••••••••••" value="" required />
            <button type="button" class="password-toggle-btn" title="Toggle password view">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <!-- Remember Me Checkbox -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label small text-muted">
                Remember this device for 30 days
            </label>
        </div>
    </div>

    <!-- Primary Submit Button -->
    <button type="submit" class="btn btn-cta w-100 py-2 mb-3">
        <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
    </button>
</form>

<!-- Quick Layer Navigation for Testing / Review -->
<div class="p-3 bg-lumora-ivory rounded-3 border-lumora-subtle mb-4">
    <small class="d-block fw-bold text-lumora-midnight mb-2 font-heading">
        <i class="bi bi-speedometer2 me-1"></i>Quick Prototype Role Access:
    </small>
    <div class="d-flex gap-2">
        <a asp-controller="Student" asp-action="Dashboard" class="btn btn-sm btn-outline-primary flex-fill">Student</a>
        <a asp-controller="Instructor" asp-action="Dashboard" class="btn btn-sm btn-outline-primary flex-fill">Instructor</a>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-sm btn-outline-primary flex-fill">Admin</a>
    </div>
</div>

<!-- Footer Link to Register -->
<div class="text-center small text-muted">
    Don't have an account yet?
    <a asp-action="Register" class="fw-bold text-lumora-midnight">Join LUMORA</a>
</div>
