    <section class="py-5 bg-white" id="verification">
      <div class="container-fluid px-lg-5">
        <div class="verification-banner text-center">
          <span class="badge badge-gold mb-3">TRUST &amp; COMPLIANCE</span>
          <h2 class="display-6 fw-bold text-white mb-2">Verify a Lumora Credential</h2>
          <p class="text-white-50 max-w-700 mx-auto mb-4">
            Employers, recruiting partners, and academic institutions can verify the authenticity, issue date, and assessment scores of any graduate certificate instantly.
          </p>

          <form id="quickCertForm" asp-controller="Verification" asp-action="Index" method="get" class="verification-input-group d-flex">
            <input type="text" id="quickCertInput" name="code" class="form-control" placeholder="Enter Certificate Hash ID (e.g. LUM-2026-9842)" required />
            <button type="submit" class="btn btn-cta">
              <i class="bi bi-shield-check me-1"></i>Verify Now
            </button>
          </form>

          <div class="mt-4 small text-white-50">
