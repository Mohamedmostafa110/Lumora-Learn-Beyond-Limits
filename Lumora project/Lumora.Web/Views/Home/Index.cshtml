                        {
                          <span class="price-original">@course.Price.ToString("C0")</span>
                        }
                      </div>
                      <a asp-controller="Catalog" asp-action="Details" asp-route-id="@course.CourseId" class="btn btn-sm btn-primary">
                        Enroll Now
                      </a>
                    </div>
                  </div>
