          <button type="button" class="btn btn-sm btn-outline-primary course-filter-btn" data-category="devops">DevOps &amp; SRE</button>
        </div>

        <!-- Courses Grid -->
        <div class="row g-4">
          @if (Model != null && Model.Any())
          {
            var icons = new[] { "bi-diagram-3-fill", "bi-layers-fill", "bi-cpu-fill", "bi-shield-lock-fill", "bi-terminal-fill", "bi-database-fill-gear" };
            var idx = 0;
            foreach (var course in Model.Take(6))
            {
              var iconClass = icons[idx % icons.Length];
              idx++;
              <div class="col-xl-4 col-md-6 course-filter-item" data-category="@GetCategorySlugs(course)">
                <div class="course-card">
                  <div class="course-thumb-wrapper">
                    <i class="bi @iconClass course-thumb-icon"></i>
                    <span class="course-level-badge">@course.Difficulty</span>
                    <span class="course-bestseller-badge">BESTSELLER</span>
                  </div>
                  <div class="card-body d-flex flex-column">
                    <div class="course-meta-tags">
                      <span><i class="bi bi-clock me-1 text-lumora-champagne-dark"></i>42 Total Hours</span>
                      <span><i class="bi bi-collection-play me-1 text-lumora-champagne-dark"></i>Self-Paced Labs</span>
                    </div>
                    <h3 class="course-title">
                      <a asp-controller="Catalog" asp-action="Details" asp-route-id="@course.CourseId">@course.Title</a>
                    </h3>
                    <div class="d-flex align-items-center gap-2 mb-3">
                      <div class="avatar-circle avatar-circle-sm">@GetInitials(course.InstructorName)</div>
                      <span class="small fw-semibold text-lumora-charcoal">@course.InstructorName</span>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mb-3">
                      <div class="rating-stars">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-half"></i>
                        <span class="ms-1 fw-bold text-dark small">@course.AverageRating.ToString("F2") (@course.TotalReviews)</span>
                      </div>
                      <span class="badge badge-slate">@(course.Categories.FirstOrDefault() ?? "Engineering")</span>
