@model IReadOnlyList<CourseCardDto>
@{
    ViewData["Title"] = null;

    string GetCategorySlugs(CourseCardDto c)
    {
        var slugs = new HashSet<string>();
        var joined = string.Join(" ", c.Categories).ToLowerInvariant() + " " + string.Join(" ", c.Tags).ToLowerInvariant() + " " + c.Title.ToLowerInvariant();
        if (joined.Contains("cloud") || joined.Contains("azure") || joined.Contains("aws")) slugs.Add("cloud");
        if (joined.Contains(".net") || joined.Contains("web") || joined.Contains("c#") || joined.Contains("architecture")) slugs.Add("dotnet");
        if (joined.Contains("ai") || joined.Contains("data") || joined.Contains("machine learning") || joined.Contains("python") || joined.Contains("llm")) slugs.Add("ai");
        if (joined.Contains("security") || joined.Contains("zero-trust")) slugs.Add("security");
        if (joined.Contains("devops") || joined.Contains("docker") || joined.Contains("kubernetes")) slugs.Add("devops");
        if (slugs.Count == 0) slugs.Add("cloud");
        return string.Join(" ", slugs);
    }

    string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "LU";
        var parts = name.Replace("Dr.", "").Replace("Eng.", "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
        return parts[0].Length >= 2 ? parts[0][..2].ToUpperInvariant() : parts[0].ToUpperInvariant();
    }

    var heroCourse = Model?.FirstOrDefault();
}

