<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Instructor Portal Dashboard") — LUMORA Enterprise</title>

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5.3 CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Chart.js (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

    <!-- Lumora Design System Styles -->
    <link href="~/css/lumora-theme.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/dashboard.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <div class="dashboard-wrapper">
        <!-- [MVC LAYOUT: _Sidebar Start] -->
        <aside class="dashboard-sidebar" id="dashboardSidebar">
            <div class="sidebar-header">
                <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center">
                    <img src="~/images/Lumora Learn Beyond Limits Logo.webp" alt="LUMORA" class="sidebar-brand-img" asp-append-version="true" />
                </a>
                <span class="badge badge-gold sidebar-role-badge">INSTRUCTOR</span>
            </div>

            <ul class="sidebar-menu">
                <li class="sidebar-label">Faculty Management</li>
                <li>
                    <a asp-controller="Instructor"
                       asp-action="Dashboard"
                       class="sidebar-link @(currentAction == "Dashboard" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Instructor"
                       asp-action="CourseBuilder"
                       class="sidebar-link @(currentAction == "CourseBuilder" ? "active" : "")">
                        <i class="bi bi-pencil-square"></i>
                        <span>Course Builder</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Instructor"
                       asp-action="MediaAndQuizBuilder"
                       class="sidebar-link @(currentAction == "MediaAndQuizBuilder" ? "active" : "")">
                        <i class="bi bi-camera-video"></i>
                        <span>Media &amp; Quizzes</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Instructor"
                       asp-action="EngagementQna"
                       class="sidebar-link @(string.Equals(currentAction, "EngagementQna", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                        <i class="bi bi-chat-dots"></i>
                        <span>Student Q&amp;A Hub</span>
                        <span class="badge badge-gold ms-auto">6</span>
                    </a>
                </li>

                <li class="sidebar-label">Public Profile</li>
                <li>
                    <a asp-controller="Catalog"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-eye"></i>
                        <span>View Public Catalog</span>
                    </a>
                </li>

                <li class="sidebar-label">Account</li>
                <li>
                    <a asp-controller="Account" asp-action="Login" class="sidebar-link text-danger">
                        <i class="bi bi-box-arrow-right text-danger"></i>
                        <span>Sign Out</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <div class="sidebar-user-card">
                    <div class="avatar-circle avatar-circle-sm">AV</div>
                    <div class="overflow-hidden">
                        <div class="small fw-bold text-white text-truncate font-heading">Alex Vance</div>
                        <div class="text-lumora-slate text-truncate" style="font-size: 0.75rem;">Principal Solutions Architect</div>
                    </div>
                </div>
            </div>
        </aside>
        <!-- [MVC LAYOUT: _Sidebar End] -->

        <div class="dashboard-main">
            @if (IsSectionDefined("Topbar"))
            {
                @await RenderSectionAsync("Topbar", required: false)
            }
            else
            {
                <!-- [MVC LAYOUT: _Topbar Start] -->
                <header class="dashboard-topbar">
                    <div class="d-flex align-items-center gap-3">
                        <button id="sidebarToggle" class="btn btn-sm btn-outline-primary d-lg-none" type="button" onclick="document.getElementById('dashboardSidebar')?.classList.toggle('sidebar-open');">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <div class="topbar-search d-none d-md-block">
                            <i class="bi bi-search"></i>
                            <input type="text" class="form-control form-control-sm" placeholder="Search my authored courses, students..." />
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Instructor" asp-action="CourseBuilder" class="btn btn-cta btn-sm">
                            <i class="bi bi-plus-lg me-1"></i>Create Masterclass
                        </a>
                    </div>
                </header>
                <!-- [MVC LAYOUT: _Topbar End] -->
            }

            @RenderBody()

            <footer class="p-3 border-top border-lumora-subtle text-center small text-muted bg-white">
                &copy; 2026 LUMORA Technologies Inc. All rights reserved. ASP.NET Core MVC compatible.
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    <script src="~/js/charts-init.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
