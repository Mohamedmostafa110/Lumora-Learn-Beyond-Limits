<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lumora</title>


    <!-- Google Fonts: Plus Jakarta Sans & Inter-->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5.3 CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Lumora Design System Styles -->
    <link href="~/css/lumora-theme.css" rel="stylesheet" />
    <link href="~/css/dashboard.css" rel="stylesheet" />
</head>
<body>

    <div class="dashboard-wrapper">
        <!-- [MVC LAYOUT: _Sidebar Start] -->
        <aside class="dashboard-sidebar" id="dashboardSidebar">
            <div class="sidebar-header">
                <a href="../index.html" class="d-flex align-items-center">
                    <img src="~/images/lumora_logo_horizontal.png" alt="LUMORA" class="sidebar-brand-img" />
                </a>
                <span class="badge badge-gold sidebar-role-badge">INSTRUCTOR</span>
            </div>

            <ul class="sidebar-menu">
                <li class="sidebar-label">Faculty Management</li>
                <li>
                    <a href="dashboard.html" class="sidebar-link">
                        <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="/instructor/coursebuilder/" class="sidebar-link ">
                        <i class="bi bi-pencil-square"></i><span>Course Builder</span>
                    </a>
                </li>
                <li>
                    <a href="/instructor/mediaandquizbuilder/" class="sidebar-link">
                        <i class="bi bi-camera-video"></i><span>Media &amp; Quizzes</span>
                    </a>
                </li>
                <li>
                    <a href="/instructor/engagementqna/" class="sidebar-link">
                        <i class="bi bi-chat-dots"></i><span>Student Q&amp;A Hub</span>
                    </a>
                </li>

                <li class="sidebar-label">Account</li>
                <li>
                    <a href="../auth/login.html" class="sidebar-link text-danger">
                        <i class="bi bi-box-arrow-right text-danger"></i><span>Sign Out</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <div class="sidebar-user-card">
                    <div class="avatar-circle avatar-circle-sm">AV</div>
                    <div class="overflow-hidden">
                        <div class="small fw-bold text-white text-truncate font-heading">Alex Vance</div>
                        <div class="text-lumora-slate text-truncate" style="font-size: 0.75rem;">Principal Solutions Architect</div>
                    </div>
                </div>
            </div>
        </aside>
        <div class="dashboard-main">
            @RenderSection("Topbar", required: false)
            <main>
                @RenderBody()
            </main>
            <footer class="p-3 border-top border-lumora-subtle text-center small text-muted bg-white">
                &copy; 2026 LUMORA Technologies Inc. All rights reserved. ASP.NET Core MVC compatible.
            </footer>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/js/main.js")"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
