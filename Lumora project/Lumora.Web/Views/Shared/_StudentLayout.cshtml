<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Portal Dashboard — LUMORA Enterprise</title>

  <!-- Google Fonts: Plus Jakarta Sans & Inter-->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Bootstrap 5.3 CSS (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <!-- Bootstrap Icons (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

  <!-- Lumora Design System Styles -->
  <link href="~/css/lumora-theme.css" rel="stylesheet" asp-append-version="true" />
  <link href="~/css/dashboard.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }
  <div class="dashboard-wrapper">
    <!-- [MVC LAYOUT: _Sidebar Start] -->
    <aside class="dashboard-sidebar" id="dashboardSidebar">
      <!-- Sidebar Header -->
      <div class="sidebar-header">
        <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center">
          <img src="~/images/Lumora Learn Beyond Limits Logo.webp" alt="LUMORA" class="sidebar-brand-img" asp-append-version="true" />
        </a>
        <span class="badge badge-gold sidebar-role-badge">STUDENT</span>
      </div>

      <!-- Navigation Menu -->
            <ul class="sidebar-menu">
                <li class="sidebar-label">Learning Hub</li>

                <li>
                    <a asp-controller="Student" asp-action="Dashboard" class="sidebar-link @(currentAction == "Dashboard" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
                    </a>
                </li>

                <li>
                    <a asp-controller="Student" asp-action="MyCourses" class="sidebar-link @(currentAction == "MyCourses" ? "active" : "")">
                        <i class="bi bi-collection-play"></i><span>My Courses</span>
                    </a>
                </li>

                <li>
                    <a asp-controller="Student" asp-action="ContinueLecture" class="sidebar-link @(currentAction == "ContinueLecture" ? "active" : "")">
                        <i class="bi bi-play-circle"></i><span>Continue Lecture</span>
                    </a>
                </li>

                <li>
                    <a asp-controller="Student" asp-action="Quizzes" class="sidebar-link @(currentAction == "Quizzes" ? "active" : "")">
                        <i class="bi bi-ui-checks"></i><span>Quizzes &amp; Labs</span>
                    </a>
                </li>

                <li>
                    <a asp-controller="Student" asp-action="Certificates" class="sidebar-link @(currentAction == "Certificates" ? "active" : "")">
                        <i class="bi bi-patch-check"></i><span>Certificates Vault</span>
                    </a>
                </li>

                <li class="sidebar-label">Catalog &amp; Discovery</li>

                <li>
                    <a asp-controller="Catalog" asp-action="Index" class="sidebar-link">
                        <i class="bi bi-compass"></i><span>Explore Catalog</span>
                    </a>
                </li>

                <li class="sidebar-label">Account &amp; Support</li>

                <li>
                    <a asp-controller="Student" asp-action="Settings" class="sidebar-link @(currentAction == "Settings" ? "active" : "")">
                        <i class="bi bi-gear"></i><span>Settings &amp; Security</span>
                    </a>
                </li>

                <li>
                    <a asp-controller="Account" asp-action="Login" class="sidebar-link text-danger">
                        <i class="bi bi-box-arrow-right text-danger"></i><span>Sign Out</span>
                    </a>
                </li>
            </ul>

      <!-- User Profile Card -->
      <div class="sidebar-footer">
        <div class="sidebar-user-card">
          <div class="avatar-circle avatar-circle-sm">MO</div>
          <div class="overflow-hidden">
            <div class="small fw-bold text-white text-truncate font-heading">Mohamed Mostafa</div>
            <div class="text-lumora-slate text-truncate" style="font-size: 0.75rem;">Enterprise Software Engineer</div>
          </div>
        </div>
      </div>
    </aside>
    <!-- [MVC LAYOUT: _Sidebar End] -->

    <!-- Main Dashboard Area -->
    <div class="dashboard-main">
      <!-- [MVC LAYOUT: _Topbar Start] -->
      <header class="dashboard-topbar">
        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-sm btn-outline-primary d-lg-none" type="button" onclick="document.getElementById('dashboardSidebar').classList.toggle('sidebar-open');">
            <i class="bi bi-list fs-5"></i>
          </button>
          <div class="topbar-search d-none d-md-block">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control form-control-sm" placeholder="Search my courses, lectures, notes..." />
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">

          <!-- Notifications Dropdown -->
          <div class="dropdown">
            <button class="btn btn-outline-primary btn-sm position-relative" type="button" data-bs-toggle="dropdown">
              <i class="bi bi-bell"></i>
              <span class="position-absolute top-0 start-100 translate-middle p-1 bg-lumora-champagne border border-white rounded-circle"></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-md">
              <li class="dropdown-header small fw-bold font-heading text-lumora-midnight">Recent Notifications</li>
              <li><a class="dropdown-item small" href="quiz.html"><i class="bi bi-award text-lumora-champagne-dark me-2"></i>Section 3 Quiz Passed (100%)</a></li>
              <li><a class="dropdown-item small" href="course-player.html"><i class="bi bi-chat-left-dots text-lumora-champagne-dark me-2"></i>Instructor replied to your Q&amp;A thread</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item small text-center text-lumora-champagne-dark fw-bold" href="#">Mark all as read</a></li>
            </ul>
          </div>

          <!-- User Quick Menu -->
          <div class="dropdown">
            <button class="btn btn-sm d-flex align-items-center gap-2 border-0 bg-transparent" type="button" data-bs-toggle="dropdown">
              <div class="avatar-circle avatar-circle-sm">MO</div>
              <span class="d-none d-md-inline small fw-semibold text-lumora-midnight">Mohamed</span>
              <i class="bi bi-chevron-down small text-muted"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-md">
              <li><h6 class="dropdown-header">Mohamed Mostafa</h6></li>
              <li><a class="dropdown-item small" asp-controller="Student" asp-action="MyCourses"><i class="bi bi-collection me-2"></i>My Learning</a></li>
              <li><a class="dropdown-item small" asp-controller="Student" asp-action="Certificates"><i class="bi bi-patch-check me-2"></i>My Certificates</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item small text-danger" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
            </ul>
          </div>
        </div>
      </header>
            @RenderBody()
            <footer class="p-3 border-top border-lumora-subtle text-center small text-muted bg-white">
                &copy; 2026 LUMORA Technologies Inc. All rights reserved. ASP.NET Core MVC compatible.
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
