@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — LUMORA" : "LUMORA — Learn Beyond Limits | Enterprise EdTech Platform")</title>

  <!-- Google Fonts: Plus Jakarta Sans & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Bootstrap 5.3 CSS (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <!-- Bootstrap Icons (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

  <!-- Lumora Design System Styles -->
  <link href="~/css/lumora-theme.css" rel="stylesheet" asp-append-version="true" />
  <link href="~/css/public.css" rel="stylesheet" asp-append-version="true" />

  @await RenderSectionAsync("Styles", required: false)
</head>
<body>

  <!-- [MVC LAYOUT: _Navbar Start] -->
  <nav class="navbar navbar-expand-lg lumora-navbar">
    <div class="container-fluid px-lg-5">
      <!-- Official Brand Logo -->
      <a class="navbar-brand d-flex align-items-center me-4" asp-controller="Home" asp-action="Index">
        <img src="~/images/Lumora Learn Beyond Limits Logo.webp" alt="LUMORA" class="navbar-brand-img" asp-append-version="true" />
      </a>

      <!-- Mobile Hamburger Button -->
      <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
        <i class="bi bi-list fs-2 text-lumora-champagne"></i>
      </button>

      <!-- Navigation Content -->
      <div class="collapse navbar-collapse" id="navbarContent">
        <!-- Main Navigation Links -->
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
          <li class="nav-item">
            <a class="nav-link nav-link-custom @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-link-custom @(currentController == "Catalog" ? "active" : "")" asp-controller="Catalog" asp-action="Index"><i class="bi bi-grid me-1"></i>Explore Courses</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-link-custom" href="/#categories"><i class="bi bi-compass me-1"></i>Learning Paths</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-link-custom" href="/#features"><i class="bi bi-shield-check me-1"></i>Enterprise</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-link-custom @(currentController == "Verification" ? "active" : "")" asp-controller="Verification" asp-action="Index"><i class="bi bi-patch-check me-1"></i>Verify Credential</a>
          </li>
        </ul>

        <!-- Search Bar -->
        <form class="nav-search-bar me-lg-3 my-2 my-lg-0" asp-controller="Catalog" asp-action="Index" method="get">
          <i class="bi bi-search search-icon"></i>
          <input type="text" name="searchTerm" class="form-control" placeholder="Search architecture, .NET, AI..." />
        </form>

        <!-- Right Side Utility Controls & Auth -->
        <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">

          <!-- Shopping Cart Pill -->
          <a asp-controller="Checkout" asp-action="Index" class="btn btn-outline-primary position-relative px-3 py-2 text-white border-lumora-subtle" title="Shopping Cart">
            <i class="bi bi-bag text-lumora-champagne"></i>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill badge-gold">
              2
            </span>
          </a>

          @if (User.Identity?.IsAuthenticated == true)
          {
              var portalController = User.IsInRole(PlatformRoles.Admin)
                  ? "Admin"
                  : User.IsInRole(PlatformRoles.Instructor)
                      ? "Instructor"
                      : "Student";

              <a asp-controller="@portalController" asp-action="Dashboard" class="btn btn-outline-primary text-white border-lumora-subtle px-3">
                  <i class="bi bi-person-circle text-lumora-champagne me-1"></i>@User.GetFullName()
              </a>

              <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                  @Html.AntiForgeryToken()
                  <button type="submit" class="btn btn-cta">
                      <i class="bi bi-box-arrow-right me-1"></i>Sign Out
                  </button>
              </form>
          }
          else
          {
              <!-- Sign In Link -->
              <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary text-white border-0 px-3">
                  Sign In
              </a>

              <!-- Primary CTA Button -->
              <a asp-controller="Account" asp-action="Register" class="btn btn-cta">
                  Get Started
              </a>
          }
        </div>
      </div>
    </div>
  </nav>
  <!-- [MVC LAYOUT: _Navbar End] -->

  <!-- [MVC VIEW: @@RenderBody() Main Content Start] -->
  @RenderBody()
  <!-- [MVC VIEW: @@RenderBody() Main Content End] -->

  <!-- [MVC LAYOUT: _Footer Start] -->
  <footer class="lumora-footer">
    <div class="container-fluid px-lg-5">
      <div class="row g-4 justify-content-between">
        <!-- Brand Info -->
        <div class="col-lg-4 col-md-6">
          <img src="~/images/Lumora Learn Beyond Limits Logo.webp" alt="LUMORA" class="navbar-brand-img mb-3" asp-append-version="true" />
          <p class="small text-muted mb-4">
            LUMORA is the premier enterprise e-learning platform dedicated to advancing software architecture, cloud distributed systems, and real-world engineering mastery.
          </p>
          <div class="d-flex gap-2">
            <a href="#" class="btn btn-sm btn-outline-primary text-white border-lumora-subtle" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
            <a href="#" class="btn btn-sm btn-outline-primary text-white border-lumora-subtle" title="GitHub"><i class="bi bi-github"></i></a>
            <a href="#" class="btn btn-sm btn-outline-primary text-white border-lumora-subtle" title="X / Twitter"><i class="bi bi-twitter-x"></i></a>
            <a href="#" class="btn btn-sm btn-outline-primary text-white border-lumora-subtle" title="YouTube"><i class="bi bi-youtube"></i></a>
          </div>
        </div>

        <!-- Quick Links: Learning Paths -->
        <div class="col-lg-2 col-md-6 col-6">
          <h6 class="footer-title">Disciplines</h6>
          <ul class="footer-links">
            <li><a asp-controller="Catalog" asp-action="Index" asp-route-searchTerm="Cloud">Cloud Architecture</a></li>
            <li><a asp-controller="Catalog" asp-action="Index" asp-route-searchTerm=".NET">.NET Clean Systems</a></li>
            <li><a asp-controller="Catalog" asp-action="Index" asp-route-searchTerm="AI">AI &amp; LLM Engineering</a></li>
            <li><a asp-controller="Catalog" asp-action="Index" asp-route-searchTerm="Security">Cybersecurity</a></li>
            <li><a asp-controller="Catalog" asp-action="Index" asp-route-searchTerm="DevOps">DevOps &amp; SRE</a></li>
          </ul>
        </div>

        <!-- Quick Links: Platform -->
        <div class="col-lg-2 col-md-6 col-6">
          <h6 class="footer-title">Platform</h6>
          <ul class="footer-links">
            <li><a asp-controller="Catalog" asp-action="Index">All Courses</a></li>
            <li><a asp-controller="Verification" asp-action="Index">Verify Certificate</a></li>
            <li><a asp-controller="Student" asp-action="Dashboard">Student Portal</a></li>
            <li><a asp-controller="Instructor" asp-action="Dashboard">Instructor Hub</a></li>
            <li><a asp-controller="Admin" asp-action="Dashboard">Admin Console</a></li>
          </ul>
        </div>

        <!-- Newsletter Subscription -->
        <div class="col-lg-3 col-md-6">
          <h6 class="footer-title">Engineering Dispatch</h6>
          <p class="small text-muted mb-3">
            Subscribe for weekly architectural patterns, whitepapers, and new course releases.
          </p>
          <form onsubmit="event.preventDefault(); LumoraToast('Thank you for subscribing to Lumora Dispatch!');">
            <div class="input-group mb-2">
              <input type="email" class="form-control form-control-sm" placeholder="engineer@company.com" required />
              <button class="btn btn-sm btn-cta" type="submit">Join</button>
            </div>
            <small class="text-muted">Zero spam. Unsubscribe anytime.</small>
          </form>
        </div>
      </div>

      <!-- Footer Bottom -->
      <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
        <div>
          &copy; 2026 LUMORA Technologies Inc. All rights reserved. Built for ASP.NET Core MVC integration.
        </div>
        <div class="d-flex gap-3">
          <a href="#" class="text-muted small">Privacy Policy</a>
          <span class="text-muted">&bull;</span>
          <a href="#" class="text-muted small">Terms of Service</a>
          <span class="text-muted">&bull;</span>
          <a href="#" class="text-muted small">Security &amp; Compliance</a>
        </div>
      </div>
    </div>
  </footer>
  <!-- [MVC LAYOUT: _Footer End] -->

  <!-- Bootstrap 5.3 JS Bundle (CDN) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Global Lumora Scripts -->
  <script src="~/js/main.js" asp-append-version="true"></script>

  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
