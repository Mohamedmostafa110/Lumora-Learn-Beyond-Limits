<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — LUMORA" : "Account — LUMORA")</title>

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5.3 CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Lumora Design System Styles -->
    <link href="~/css/lumora-theme.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/public.css" rel="stylesheet" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="auth-split-wrapper">
        <!-- Left Column: Architectural Brand Experience -->
        <div class="auth-brand-pane d-none d-lg-flex">
            <div>
                <a asp-controller="Home" asp-action="Index">
                    <img src="~/images/Lumora Learn Beyond Limits Logo.webp" alt="LUMORA" style="height: 44px; object-fit: contain;" />
                </a>
            </div>

            <div class="my-auto py-5">
                <div class="auth-stats-badge mb-4">
                    <i class="bi bi-shield-check"></i> Enterprise Certified Learning Portal
                </div>
                <h2 class="display-6 fw-bold text-white mb-3 font-heading">
                    Engineered for <br /><span class="text-lumora-champagne">High-Performance</span> Teams.
                </h2>
                <p class="text-white-50 lead mb-4">
                    Access your enrolled architecture masterclasses, interactive cloud sandbox labs, and cryptographically verified certificates.
                </p>

                <div class="auth-brand-quote">
                    <p class="mb-2">
                        "LUMORA’s production capstone projects transformed our engineering leads from theoretical developers to confident distributed systems architects."
                    </p>
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-circle avatar-circle-sm">SL</div>
                        <div>
                            <div class="small fw-bold text-white">Sean Larson</div>
                            <small class="text-lumora-slate">VP of Platform Infrastructure</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center text-white-50 small">
                <span>&copy; @DateTime.UtcNow.Year LUMORA Technologies</span>
                <span class="text-lumora-slate">Learn Beyond Limits</span>
            </div>
        </div>

        <!-- Right Column: Authentication Form Canvas -->
        <div class="auth-form-pane">
            <div class="auth-card">
                <!-- Mobile Logo Display -->
                <div class="text-center d-lg-none mb-4">
                    <a asp-controller="Home" asp-action="Index">
                        <img src="~/images/Lumora Learn Beyond Limits Logo.webp" alt="LUMORA" style="height: 38px; object-fit: contain;" />
                    </a>
                </div>

                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Bootstrap 5.3 JS Bundle (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Lumora Scripts -->
    <script src="~/js/main.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
