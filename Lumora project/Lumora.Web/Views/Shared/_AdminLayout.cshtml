<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@(ViewData["Title"] ?? "Admin Dashboard") — LUMORA Governance</title>

  <!-- Google Fonts: Plus Jakarta Sans & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Bootstrap 5.3 CSS (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <!-- Bootstrap Icons (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

  <!-- Lumora Design System Styles -->
  <link href="/css/lumora-theme.css" rel="stylesheet" asp-append-version="true" />
  <link href="/css/dashboard.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>
  <div class="dashboard-wrapper">
    <!-- [MVC LAYOUT: _Sidebar Start] -->
    <aside class="dashboard-sidebar" id="dashboardSidebar">
      <div class="sidebar-header">
        <a href="/" class="d-flex align-items-center">
          <img src="/images/lumora_logo_horizontal.png" alt="LUMORA" class="sidebar-brand-img" asp-append-version="true" />
        </a>
        <span class="badge badge-gold sidebar-role-badge">ADMIN</span>
      </div>

      <ul class="sidebar-menu">
        <li class="sidebar-label">Platform Governance</li>
        <li>
          <a href="/Admin/Dashboard" class="sidebar-link">
            <i class="bi bi-speedometer2"></i><span>Master Console</span>
          </a>
        </li>
        <li>
          <a href="/Admin/CourseApprovals" class="sidebar-link">
            <i class="bi bi-shield-check"></i><span>Course QA Queue</span>
            <span class="badge badge-gold ms-auto">3</span>
          </a>
        </li>
        <li>
          <a href="/Admin/UsersManagement" class="sidebar-link">
            <i class="bi bi-people-fill"></i><span>Users Management</span>
          </a>
        </li>
        <li>
          <a href="/Admin/TaxonomyAndCoupons" class="sidebar-link">
            <i class="bi bi-tags-fill"></i><span>Taxonomy &amp; Coupons</span>
          </a>
        </li>

        <li class="sidebar-label">Account</li>
        <li>
          <a href="/Auth/Login" class="sidebar-link text-danger">
            <i class="bi bi-box-arrow-right text-danger"></i><span>Sign Out</span>
          </a>
        </li>
      </ul>

      <div class="sidebar-footer">
        <div class="sidebar-user-card">
          <div class="avatar-circle avatar-circle-sm">SA</div>
          <div class="overflow-hidden">
            <div class="small fw-bold text-white text-truncate font-heading">Security Admin</div>
            <div class="text-lumora-slate text-truncate" style="font-size: 0.75rem;">Platform Operations Lead</div>
          </div>
        </div>
      </div>
    </aside>
    <!-- [MVC LAYOUT: _Sidebar End] -->

    <div class="dashboard-main d-flex flex-column min-vh-100">
      <!-- [MVC LAYOUT: _Topbar Start] -->
      <header class="dashboard-topbar">
        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-sm btn-outline-primary d-lg-none" type="button" onclick="document.getElementById('dashboardSidebar').classList.toggle('sidebar-open');">
            <i class="bi bi-list fs-5"></i>
          </button>
          <span class="fw-bold text-lumora-midnight">@ViewData["TopbarTitle"]</span>
        </div>

        <div class="d-flex align-items-center gap-2"></div>
      </header>
      <!-- [MVC LAYOUT: _Topbar End] -->

      <!-- [MVC VIEW: Main Content Start] -->
      <div class="flex-grow-1">
        @RenderBody()
      </div>
      <!-- [MVC VIEW: Main Content End] -->

      <footer class="p-3 border-top border-lumora-subtle text-center small text-muted bg-white mt-auto">
        &copy; 2026 LUMORA Technologies Inc. All rights reserved. ASP.NET Core MVC compatible.
      </footer>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>