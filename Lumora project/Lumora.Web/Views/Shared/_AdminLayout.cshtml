<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Governance Console — LUMORA Enterprise</title>

  <!-- Google Fonts: Plus Jakarta Sans & Inter-->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Bootstrap 5.3 CSS (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <!-- Bootstrap Icons (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

  <!-- Lumora Design System Styles -->
    <link href="~/css/lumora-theme.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/dashboard.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <div class="dashboard-wrapper">
        <!-- [MVC LAYOUT: _Sidebar Start] -->
        <aside class="dashboard-sidebar" id="dashboardSidebar">
            <div class="sidebar-header">
                <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center">
                    <img src="~/images/Lumora Learn Beyond Limits Logo.webp" alt="LUMORA" class="sidebar-brand-img" asp-append-version="true" />
                </a>
                <span class="badge badge-gold sidebar-role-badge">ADMIN</span>
            </div>

            <ul class="sidebar-menu">
                <li class="sidebar-label">Platform Governance</li>
                <li>
                    <a asp-controller="Admin"
                       asp-action="Dashboard"
                       class="sidebar-link @(currentAction == "Dashboard" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i><span>Master Console</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin"
                       asp-action="CourseApprovals"
                       class="sidebar-link @(currentAction == "CourseApprovals" ? "active" : "")">
                        <i class="bi bi-shield-check"></i><span>Course QA Queue</span>
                        <span class="badge badge-gold ms-auto">3</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin"
                       asp-action="UsersManagement"
                       class="sidebar-link @(currentAction == "UsersManagement" ? "active" : "")">
                        <i class="bi bi-people-fill"></i><span>Users Management</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin"
                       asp-action="TaxonomyAndCoupons"
                       class="sidebar-link @(currentAction == "TaxonomyAndCoupons" ? "active" : "")">
                        <i class="bi bi-tags-fill"></i><span>Taxonomy &amp; Coupons</span>
                    </a>
                </li>

                <li class="sidebar-label">System Security</li>
                <li>
                    <a asp-controller="Verification"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-patch-check"></i><span>Cert Ledger Audit</span>
                    </a>
                </li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sidebar-link text-danger border-0 bg-transparent w-100 text-start">
                            <i class="bi bi-box-arrow-right text-danger"></i><span>Sign Out</span>
                        </button>
                    </form>
                </li>
            </ul>

            <div class="sidebar-footer">
                <div class="sidebar-user-card">
                    <div class="avatar-circle avatar-circle-sm">@User.GetInitials()</div>
                    <div class="overflow-hidden">
                        <div class="small fw-bold text-white text-truncate font-heading">@User.GetFullName()</div>
                        <div class="text-lumora-slate text-truncate" style="font-size: 0.75rem;">Platform Administrator</div>
                    </div>
                </div>
            </div>
        </aside>
        <!-- [MVC LAYOUT: _Sidebar End] -->

        <div class="dashboard-main">
            <!-- [MVC LAYOUT: _Topbar Start] -->
            <header class="dashboard-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm btn-outline-primary d-lg-none"
                            type="button"
                            onclick="document.getElementById('dashboardSidebar')?.classList.toggle('sidebar-open');">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    @if (ViewData["TopbarTitle"] != null)
                    {
                        <span class="fw-bold text-lumora-midnight d-none d-lg-inline">@ViewData["TopbarTitle"]</span>
                    }
                    <div class="topbar-search d-none d-md-block">
                        <i class="bi bi-search"></i>
                        <input type="text" class="form-control form-control-sm" placeholder="Search platform users, courses, audit logs..." />
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="badge badge-gold d-none d-sm-inline">
                        <i class="bi bi-shield-fill-check me-1"></i>ISO 27001 AUDITED
                    </span>
                </div>
            </header>
            <!-- [MVC LAYOUT: _Topbar End] -->
            @RenderBody()
            <footer class="p-3 border-top border-lumora-subtle text-center small text-muted bg-white">
                &copy; 2026 LUMORA Technologies Inc. All rights reserved. ASP.NET Core MVC compatible.
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    <script src="~/js/charts-init.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>