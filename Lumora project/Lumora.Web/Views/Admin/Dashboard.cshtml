@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<main class="dashboard-content">
    <!-- Dashboard Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="h3 fw-bold text-lumora-midnight mb-1 font-heading">Enterprise Governance Dashboard</h2>
            <p class="text-muted small mb-0">Platform-wide health telemetry, curriculum approval queues, and cryptographic certificate issuance oversight.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="course-approvals.html" class="btn btn-cta btn-sm">
                <i class="bi bi-shield-check me-1"></i>Review Pending Courses (3)
            </a>
        </div>
    </div>

    <!-- Master Platform KPI Cards -->
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted text-uppercase fw-bold letter-spacing-1">Total Learners</small>
                        <div class="kpi-value">52,400</div>
                        <span class="kpi-trend"><i class="bi bi-arrow-up-right"></i>+14.2% Growth</span>
                    </div>
                    <div class="kpi-icon-box">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted text-uppercase fw-bold letter-spacing-1">Live Curricula</small>
                        <div class="kpi-value">142</div>
                        <span class="kpi-trend"><i class="bi bi-check-circle"></i>Across 6 Tracks</span>
                    </div>
                    <div class="kpi-icon-box">
                        <i class="bi bi-collection-play-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted text-uppercase fw-bold letter-spacing-1">Verifiable Certs</small>
                        <div class="kpi-value">5,820</div>
                        <span class="kpi-trend"><i class="bi bi-patch-check-fill"></i>100% Stamped</span>
                    </div>
                    <div class="kpi-icon-box">
                        <i class="bi bi-award-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted text-uppercase fw-bold letter-spacing-1">Pending QA Queue</small>
                        <div class="kpi-value">3</div>
                        <span class="kpi-trend"><i class="bi bi-hourglass-split"></i>Action Required</span>
                    </div>
                    <div class="kpi-icon-box">
                        <i class="bi bi-shield-exclamation"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Telemetry Charts (Line & Doughnut) -->
    <div class="row g-4 mb-4">
        <!-- Growth Chart (8 Cols) -->
        <div class="col-lg-8">
            <div class="card p-4 border-lumora-subtle bg-white shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-lumora-subtle">
                    <div>
                        <h5 class="fw-bold text-lumora-midnight mb-0 font-heading">Platform Growth &amp; Verifiable Certs Issuance</h5>
                        <small class="text-muted">Trailing 7 Months Telemetry</small>
                    </div>
                    <span class="badge badge-gold">NAVY &bull; GOLD TELEMETRY</span>
                </div>
                <div style="height: 290px;">
                    <canvas id="adminPlatformGrowthChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Users Breakdown Doughnut (4 Cols) -->
        <div class="col-lg-4">
            <div class="card p-4 border-lumora-subtle bg-white shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-lumora-subtle">
                    <div>
                        <h5 class="fw-bold text-lumora-midnight mb-0 font-heading">Users by Role</h5>
                        <small class="text-muted">Active Platform Distribution</small>
                    </div>
                </div>
                <div style="height: 290px;">
                    <canvas id="adminUserRoleDoughnut"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Audit Events Table -->
    <div class="card p-4 border-lumora-subtle bg-white shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-lumora-subtle">
            <h5 class="fw-bold text-lumora-midnight mb-0 font-heading">Real-Time Platform Governance Audit Events</h5>
            <span class="badge badge-navy">EVENT STREAM LOG</span>
        </div>

        <div class="table-responsive">
            <table class="table align-middle small">
                <thead>
                    <tr>
                        <th>Event ID</th>
                        <th>Action Type</th>
                        <th>Target Resource</th>
                        <th>Actor / Initiator</th>
                        <th>Timestamp</th>
                        <th class="text-end">Audit Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><code>EVT-98420-APV</code></td>
                        <td><span class="badge badge-gold">COURSE_APPROVED</span></td>
                        <td><strong>Distributed Systems at Scale</strong></td>
                        <td>Admin (Staff Lead)</td>
                        <td>Nov 12, 2026 &bull; 19:42 UTC</td>
                        <td class="text-end"><span class="badge badge-gold">COMMITTED</span></td>
                    </tr>
                    <tr>
                        <td><code>EVT-98419-CRT</code></td>
                        <td><span class="badge badge-navy">CERTIFICATE_STAMPED</span></td>
                        <td><code>LUM-2026-9842 (Mohamed M.)</code></td>
                        <td>Automated Grading Engine</td>
                        <td>Nov 12, 2026 &bull; 18:30 UTC</td>
                        <td class="text-end"><span class="badge badge-gold">COMMITTED</span></td>
                    </tr>
                    <tr>
                        <td><code>EVT-98418-CPN</code></td>
                        <td><span class="badge badge-slate">COUPON_CREATED</span></td>
                        <td><code>LUMORA-ENTERPRISE-20</code></td>
                        <td>Commercial Admin</td>
                        <td>Nov 12, 2026 &bull; 15:10 UTC</td>
                        <td class="text-end"><span class="badge badge-gold">ACTIVE</span></td>
                    </tr>
                    <tr>
                        <td><code>EVT-98417-QNT</code></td>
                        <td><span class="badge badge-error">COURSE_CHANGES_REQUESTED</span></td>
                        <td><strong>Kubernetes Microservices Mesh</strong></td>
                        <td>Admin Reviewer</td>
                        <td>Nov 11, 2026 &bull; 21:05 UTC</td>
                        <td class="text-end"><span class="badge badge-slate">DISPATCHED</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</main>