@model CourseDetailDto
@{
    ViewData["Title"] = "Secure Cart & Checkout";
    var price = Model?.Price ?? 1200m;
    var discount = Model?.Discount ?? 200m;
    var finalPrice = Model?.FinalPrice ?? 1000m;
    var courseTitle = Model?.Title ?? "Mastering .NET 10 & Microservices Architecture";
    var courseInstructor = Model?.InstructorName ?? "Eng. Mohamed Adel";
    var courseId = Model?.CourseId ?? "1";
    var courseDifficulty = Model?.Difficulty.ToString() ?? "Advanced";
}

  <main class="py-5 bg-lumora-ivory">
    <div class="container-fluid px-lg-5">
      <!-- Breadcrumb & Title -->
      <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
          <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-lumora-slate">Home</a></li>
          <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index" class="text-lumora-slate">Catalog</a></li>
          <li class="breadcrumb-item active text-lumora-midnight fw-semibold" aria-current="page">Cart &amp; Checkout</li>
        </ol>
      </nav>

      <div class="mb-4">
        <h1 class="h2 fw-bold text-lumora-midnight mb-1 font-heading">Secure Cart &amp; Checkout</h1>
        <p class="text-muted small mb-0">Review your selected masterclasses and finalize your enterprise enrollment.</p>
      </div>

      <div class="row g-4">
        <!-- Left Column: Cart Items & Add-ons -->
        <div class="col-lg-7">
          <!-- Cart Items Card -->
          <div class="card p-4 border-lumora-subtle mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-lumora-subtle">
              <h5 class="fw-bold mb-0 font-heading">Enrolled Courses in Cart (1 Item)</h5>
              <a asp-controller="Catalog" asp-action="Index" class="small fw-semibold text-lumora-champagne-dark">Add More Courses</a>
            </div>

            <!-- Selected Course Item -->
            <div class="d-flex flex-column flex-sm-row gap-3 py-3 align-items-sm-center">
              <div class="trust-icon-box bg-lumora-midnight text-lumora-champagne rounded-3 p-3 flex-shrink-0">
                <i class="bi bi-diagram-3-fill fs-3"></i>
              </div>
              <div class="flex-grow-1">
                <h6 class="fw-bold text-lumora-midnight mb-1 font-heading">
                  <a asp-controller="Catalog" asp-action="Details" asp-route-id="@courseId">@courseTitle</a>
                </h6>
                <div class="small text-muted mb-2">By @courseInstructor &bull; Self-Paced Labs &bull; Verifiable Credential</div>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge badge-gold">@courseDifficulty</span>
                  <a asp-controller="Catalog" asp-action="Index" class="btn btn-link btn-sm text-danger text-decoration-none p-0 small">
                    <i class="bi bi-trash3 me-1"></i>Change Course
                  </a>
                </div>
              </div>
              <div class="text-sm-end">
                <div class="fs-5 fw-bold text-lumora-midnight font-heading">@finalPrice.ToString("C0")</div>
                @if (discount > 0)
                {
                  <small class="text-muted text-decoration-line-through">@price.ToString("C0")</small>
                }
              </div>
            </div>
          </div>

          <!-- Add-on Accreditation Seal Card -->
          <div class="card p-4 border-lumora-subtle bg-white mb-4">
            <div class="d-flex align-items-start gap-3">
              <div class="form-check mt-1">
                <input class="form-check-input" type="checkbox" id="sealAddon" checked />
              </div>
              <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <h6 class="fw-bold text-lumora-midnight mb-0 font-heading">
                    <i class="bi bi-patch-check-fill text-lumora-champagne-dark me-1"></i>Institutional Verified Accreditation Seal
                  </h6>
                  <span class="fw-bold text-lumora-midnight font-heading">Included</span>
                </div>
                <p class="small text-muted mb-0">
                  Includes permanent cryptographic hash registration on public ledger, official PDF embossed seal, and instant LinkedIn badge verification.
                </p>
              </div>
            </div>
          </div>

          <!-- Promo Coupon Section -->
          <div class="card p-4 border-lumora-subtle bg-white">
            <h6 class="fw-bold text-lumora-midnight mb-2 font-heading">Have a Promotional Voucher or Enterprise Code?</h6>
            <div class="d-flex gap-2">
              <input type="text" id="promoCodeVisible" class="form-control" placeholder="Enter coupon code (e.g. LUMORA20 or FLAT100)" />
              <button type="button" class="btn btn-outline-primary fw-semibold text-nowrap" onclick="const v = document.getElementById('promoCodeVisible').value.trim(); document.getElementById('hiddenCouponInput').value = v; LumoraToast(v ? 'Coupon ' + v + ' attached to checkout!' : 'Please enter a coupon code.');">Apply Code</button>
            </div>
            <div class="d-flex align-items-center gap-2 mt-2">
              <span class="badge badge-gold">Try: LUMORA20 or FLAT100</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Order Summary & Stripe Payment Form -->
        <div class="col-lg-5">
          <div class="card p-4 border-lumora-subtle shadow-md sticky-top" style="top: 85px; z-index: 10;">
            <h5 class="fw-bold text-lumora-midnight mb-3 pb-2 border-bottom border-lumora-subtle font-heading">
              Order Summary
            </h5>

            <!-- Summary Breakdown -->
            <div class="d-flex flex-column gap-2 small mb-3">
              <div class="d-flex justify-content-between text-muted">
                <span>Original Price</span>
                <span>@price.ToString("C2")</span>
              </div>
              <div class="d-flex justify-content-between text-muted">
                <span>Institutional Verified Seal</span>
                <span>$0.00</span>
              </div>
              @if (discount > 0)
              {
                <div class="d-flex justify-content-between text-lumora-champagne-dark fw-bold">
                  <span>Curriculum Discount</span>
                  <span>-@discount.ToString("C2")</span>
                </div>
              }
              <div class="d-flex justify-content-between text-muted">
                <span>Estimated Taxes (0% Educational)</span>
                <span>$0.00</span>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-lumora-subtle mb-4">
              <span class="h5 fw-bold text-lumora-midnight mb-0 font-heading">Total Due:</span>
              <span class="h4 fw-bold text-lumora-midnight mb-0 font-heading">@finalPrice.ToString("C2")</span>
            </div>

            <!-- Payment Simulation Form -->
            <h6 class="fw-bold text-lumora-midnight mb-3 font-heading">
              <i class="bi bi-credit-card-2-front text-lumora-champagne-dark me-2"></i>Payment Details
            </h6>

            <form asp-controller="Checkout" asp-action="Process" method="post">
              @Html.AntiForgeryToken()
              <input type="hidden" name="CourseIds" value="@courseId" />
              <input type="hidden" name="PaymentProvider" value="Stripe" />
              <input type="hidden" name="CouponCode" id="hiddenCouponInput" value="" />

              <!-- Name on Card -->
              <div class="mb-3">
                <label for="cardName" class="form-label">Name on Card</label>
                <input type="text" class="form-control form-control-sm" id="cardName" placeholder="Full name as printed on card" required />
              </div>

              <!-- Card Number -->
              <div class="mb-3">
                <label for="cardNumber" class="form-label">Card Number</label>
                <div class="input-group input-group-sm">
                  <span class="input-group-text bg-white text-lumora-slate border-lumora-subtle">
                    <i class="bi bi-credit-card"></i>
                  </span>
                  <input type="text" class="form-control" id="cardNumber" placeholder="4242 •••• •••• 4242" required />
                </div>
              </div>

              <!-- Expiry & CVC -->
              <div class="row g-2 mb-3">
                <div class="col-6">
                  <label for="cardExp" class="form-label">Expiry (MM/YY)</label>
                  <input type="text" class="form-control form-control-sm" id="cardExp" placeholder="12/28" required />
                </div>
                <div class="col-6">
                  <label for="cardCvc" class="form-label">CVC / CVV</label>
                  <input type="text" class="form-control form-control-sm" id="cardCvc" placeholder="CVC" required />
                </div>
              </div>

              <!-- Country & Billing Zip -->
              <div class="row g-2 mb-4">
                <div class="col-7">
                  <label for="billingCountry" class="form-label">Country</label>
                  <select class="form-select form-select-sm" id="billingCountry">
                    <option value="EG" selected>Egypt</option>
                    <option value="US">United States</option>
                    <option value="AE">United Arab Emirates</option>
                    <option value="SA">Saudi Arabia</option>
                    <option value="GB">United Kingdom</option>
                    <option value="DE">Germany</option>
                  </select>
                </div>
                <div class="col-5">
                  <label for="billingZip" class="form-label">Postal Code</label>
                  <input type="text" class="form-control form-control-sm" id="billingZip" placeholder="Zip code" required />
                </div>
              </div>

              <!-- Submit Payment CTA -->
              <button type="submit" class="btn btn-cta w-100 py-2 fs-6 mb-3">
                <i class="bi bi-lock-fill me-2"></i>Complete Secure Enrollment (@finalPrice.ToString("C2"))
              </button>
            </form>

            <!-- Trust Marks -->
            <div class="d-flex flex-column gap-2 text-center text-muted small border-top border-lumora-subtle pt-3">
              <div><i class="bi bi-shield-check text-lumora-champagne-dark me-1"></i>256-Bit TLS Bank-Grade Encrypted Connection</div>
              <div><i class="bi bi-arrow-repeat text-lumora-champagne-dark me-1"></i>Instant Enrollment &bull; Access Courses Immediately</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
