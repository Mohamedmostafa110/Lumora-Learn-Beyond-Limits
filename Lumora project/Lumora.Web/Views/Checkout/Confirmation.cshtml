@{
    ViewData["Title"] = "Order Confirmed";
    var orderId = ViewBag.OrderId ?? 101;
}

<div class="py-5 bg-lumora-ivory">
    <div class="container px-lg-5 text-center">
        <div class="max-w-600 mx-auto py-5" style="max-width: 600px;">
            <div class="trust-icon-box bg-white text-lumora-champagne-dark rounded-circle mx-auto mb-4 shadow-sm" style="width: 80px; height: 80px; font-size: 2.5rem; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <h1 class="display-6 fw-bold text-lumora-midnight font-heading mb-2">Enrollment Confirmed!</h1>
            <p class="lead text-muted mb-4">
                Thank you for investing in your engineering growth. Your transaction was processed securely.
            </p>

            <div class="card p-4 border-lumora-subtle bg-white text-start mb-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-lumora-subtle">
                    <span class="text-muted small">ORDER REFERENCE</span>
                    <strong class="font-monospace text-lumora-midnight">#ORD-@orderId-2026</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2 small">
                    <span class="text-muted">Payment Provider:</span>
                    <span class="fw-semibold text-lumora-midnight">Stripe (Test Mode)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2 small">
                    <span class="text-muted">Status:</span>
                    <span class="badge badge-gold">Completed &bull; Enrolled</span>
                </div>
                <div class="d-flex justify-content-between align-items-center small">
                    <span class="text-muted">Access Granted:</span>
                    <span class="fw-semibold text-lumora-midnight">Immediate Lifetime Access</span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-3 justify-content-center">
                <a asp-controller="Student" asp-action="Dashboard" class="btn btn-cta px-4 py-2">
                    <i class="bi bi-play-circle me-2"></i>Go to Student Learning Portal
                </a>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary px-4 py-2">
                    Browse More Courses
                </a>
            </div>
        </div>
    </div>
</div>
