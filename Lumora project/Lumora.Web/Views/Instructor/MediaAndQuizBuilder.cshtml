@{
    ViewData["Title"] = "Media&Quizes";
    Layout = "_InstructorLayout";
}
<head>

    <style>
            .upload-dropzone {
                border: 2px dashed rgba(214, 183, 121, 0.5);
                border-radius: var(--lumora-radius-card);
                padding: 3rem 2rem;
                text-align: center;
                background-color: var(--lumora-ivory);
                cursor: pointer;
                transition: var(--lumora-transition);
            }

                .upload-dropzone:hover {
                    border-color: var(--lumora-champagne);
                    background-color: #FFFFFF;
                    box-shadow: var(--lumora-shadow-sm);
                }
    </style>
</head>
<div class="dashboard-wrapper">



    <div class="dashboard-main">

        @section Topbar {
            <header class="dashboard-topbar">
                <!-- محتوى الهيدر الخاص بالصفحة دي -->
            </header>
        }
        <main class="dashboard-content">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
                <div>
                    <h2 class="h3 fw-bold text-lumora-midnight mb-1 font-heading">Media &amp; Assessment Studio</h2>
                    <p class="text-muted small mb-0">Direct Azure Blob video upload with automated HLS transcoding, plus section quiz authoring with rationale keys.</p>
                </div>
                <span class="badge badge-gold">AZURE STORAGE V12 INTEGRATED</span>
            </div>

            <div class="row g-4 mb-4">
                <!-- 1. Azure Blob Video Uploader Column (6 Cols) -->
                <div class="col-lg-6">
                    <div class="card p-4 border-lumora-subtle bg-white h-100 shadow-sm">
                        <h5 class="fw-bold text-lumora-midnight mb-2 font-heading">
                            <i class="bi bi-cloud-arrow-up text-lumora-champagne-dark me-2"></i>Azure Blob Video Asset Uploader
                        </h5>
                        <p class="small text-muted mb-3">
                            Upload raw master video files (.mp4 / .mov). Our automated pipeline encodes them into adaptive multi-bitrate HLS streams for smooth worldwide streaming.
                        </p>

                        <!-- Upload Drag-and-Drop Area -->
                        <div class="upload-dropzone mb-3" onclick="document.getElementById('fileUploadInput').click();">
                            <input type="file" id="fileUploadInput" class="d-none" accept="video/mp4,video/quicktime" onchange="LumoraToast('File selected: ' + this.files[0].name + ' — Uploading to Azure Blob...');" />
                            <i class="bi bi-cloud-upload text-lumora-champagne-dark display-4 d-block mb-2"></i>
                            <h6 class="fw-bold text-lumora-midnight mb-1 font-heading">Drag &amp; drop video file here, or browse</h6>
                            <div class="small text-muted">Supports MP4, MOV up to 4GB &bull; 1080p 60fps recommended</div>
                        </div>

                        <!-- Transcoding Status Telemetry Box -->
                        <div class="p-3 bg-lumora-ivory rounded-3 border-lumora-subtle mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-cpu text-lumora-champagne-dark fs-5"></i>
                                    <strong class="small text-lumora-midnight">Azure Transcoding Telemetry:</strong>
                                </div>
                                <span class="badge badge-gold">HLS READY</span>
                            </div>
                            <div class="row g-2 small text-muted">
                                <div class="col-6">Resolution: <strong class="text-dark">1920x1080 (1080p)</strong></div>
                                <div class="col-6">Bitrate: <strong class="text-dark">4,500 kbps Adaptive</strong></div>
                                <div class="col-6">Audio: <strong class="text-dark">AAC 48kHz Stereo</strong></div>
                                <div class="col-6">DRM Protection: <strong class="text-dark">AES-128 Tokenized</strong></div>
                            </div>
                        </div>

                        <!-- Uploaded Asset Preview Card -->
                        <div class="d-flex align-items-center justify-content-between p-2 rounded-2 border border-lumora-subtle bg-white">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-file-earmark-play-fill text-lumora-champagne-dark fs-4"></i>
                                <div>
                                    <div class="small fw-bold text-lumora-midnight font-heading">Lecture24-Kafka-Replay.mp4</div>
                                    <small class="text-muted">482 MB &bull; Uploaded 12 minutes ago</small>
                                </div>
                            </div>
                            <button class="btn btn-sm btn-outline-primary" onclick="LumoraToast('Previewing video player stream...');">
                                <i class="bi bi-play-circle me-1"></i>Preview
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 2. Section Quiz Authoring Column (6 Cols) -->
                <div class="col-lg-6">
                    <div class="card p-4 border-lumora-subtle bg-white h-100 shadow-sm">
                        <h5 class="fw-bold text-lumora-midnight mb-2 font-heading">
                            <i class="bi bi-ui-checks text-lumora-champagne-dark me-2"></i>Section Assessment Question Authoring
                        </h5>
                        <p class="small text-muted mb-3">
                            Create architectural multiple-choice questions with mandatory rationale explanations for instant automated grading.
                        </p>

                        <form onsubmit="event.preventDefault(); LumoraToast('New question saved to Section Assessment!');">
                            <!-- Target Section -->
                            <div class="mb-3">
                                <label class="form-label">Target Curriculum Section</label>
                                <select class="form-select form-select-sm">
                                    <option value="s1">Section 1: Distributed Foundations</option>
                                    <option value="s2">Section 2: High-Throughput Event-Driven Pipelines</option>
                                    <option value="s4" selected>Section 4: CQRS &amp; Event Sourcing Assessment</option>
                                </select>
                            </div>

                            <!-- Question Text -->
                            <div class="mb-3">
                                <label class="form-label">Question Text (Problem Scenario)</label>
                                <textarea class="form-control form-control-sm" rows="2" placeholder="e.g. When designing an active-active multi-region database, which mechanism resolves conflicting concurrent writes?" required></textarea>
                            </div>

                            <!-- Answer Choices -->
                            <div class="d-flex flex-column gap-2 mb-3">
                                <label class="form-label mb-0">Answer Choices &amp; Correct Key</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white">
                                        <input class="form-check-input mt-0" type="radio" name="newQCorrect" value="a" required />
                                    </span>
                                    <input type="text" class="form-control" placeholder="Option A description" required />
                                </div>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white">
                                        <input class="form-check-input mt-0" type="radio" name="newQCorrect" value="b" />
                                    </span>
                                    <input type="text" class="form-control" placeholder="Option B description" required />
                                </div>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white">
                                        <input class="form-check-input mt-0" type="radio" name="newQCorrect" value="c" />
                                    </span>
                                    <input type="text" class="form-control" placeholder="Option C description" required />
                                </div>
                            </div>

                            <!-- Architectural Rationale (Mandatory) -->
                            <div class="mb-3">
                                <label class="form-label">Architectural Rationale / Explanation Key</label>
                                <textarea class="form-control form-control-sm" rows="2" placeholder="Explain the technical principle so the student understands why this choice is correct." required></textarea>
                            </div>

                            <button type="submit" class="btn btn-cta btn-sm w-100">
                                <i class="bi bi-plus-circle me-1"></i>Add Question to Section Assessment
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </main>



    </div>
</div>