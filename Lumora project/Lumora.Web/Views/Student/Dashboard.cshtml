@model Lumora.DTOs.Dashboard.StudentDashboardDto
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}
<main class="dashboard-content">
    <!-- Welcome Greeting Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="h3 fw-bold text-lumora-midnight mb-1 font-heading">@Model.Greeting, @Model.StudentName!</h2>
            @if (Model.InProgressCount > 0)
            {
                <p class="text-muted small mb-0">You have <strong>@Model.InProgressCount course(s) in progress</strong>. Keep going, you are @Model.OverallCompletionPercent% of the way there.</p>
            }
            else if (Model.EnrolledCount > 0)
            {
                <p class="text-muted small mb-0">You have completed all your courses. Great work!</p>
            }
            else
            {
                <p class="text-muted small mb-0">Explore the catalog and enroll in your first course.</p>
            }
        </div>
        <div class="d-flex gap-2">
            @if (Model.ContinueLearning is not null)
            {
                <a asp-controller="Student" asp-action="ContinueLecture" class="btn btn-cta btn-sm">
                    <i class="bi bi-play-fill me-1"></i>Resume Latest Lecture
                </a>
            }
            <a asp-controller="Student" asp-action="Certificates" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-patch-check me-1"></i>View Certificates
            </a>
        </div>
    </div>

    <!-- KPI Performance Cards -->
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted text-uppercase fw-bold letter-spacing-1">Enrolled Courses</small>
                        <div class="kpi-value">@Model.EnrolledCount</div>
                        <span class="kpi-trend"><i class="bi bi-arrow-up-right"></i>@Model.InProgressCount Active in Progress</span>
                    </div>
                    <div class="kpi-icon-box"><i class="bi bi-collection-play"></i></div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted text-uppercase fw-bold letter-spacing-1">Overall Completion</small>
                        <div class="kpi-value">@Model.OverallCompletionPercent%</div>
                        <span class="kpi-trend"><i class="bi bi-arrow-up-right"></i>Across all courses</span>
                    </div>
                    <div class="kpi-icon-box"><i class="bi bi-pie-chart"></i></div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted text-uppercase fw-bold letter-spacing-1">Lessons Completed</small>
                        <div class="kpi-value">@Model.LessonsCompleted</div>
                        <span class="kpi-trend"><i class="bi bi-clock-history"></i>Keep it up</span>
                    </div>
                    <div class="kpi-icon-box"><i class="bi bi-hourglass-split"></i></div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted text-uppercase fw-bold letter-spacing-1">Verified Credentials</small>
                        <div class="kpi-value">@Model.CertificatesCount</div>
                        <span class="kpi-trend"><i class="bi bi-shield-check"></i>100% Verifiable</span>
                    </div>
                    <div class="kpi-icon-box"><i class="bi bi-patch-check-fill"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Continue Learning Hero Spotlight Card -->
    @if (Model.ContinueLearning is { } cl)
    {
        <div class="card p-4 border-lumora-subtle bg-white shadow-sm mb-4">
            <div class="row align-items-center gy-3">
                <div class="col-lg-8">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge badge-gold">CONTINUE WHERE YOU LEFT OFF</span>
                    </div>
                    <h4 class="fw-bold text-lumora-midnight mb-2 font-heading">@cl.CourseTitle</h4>
                    @if (!string.IsNullOrEmpty(cl.NextLessonTitle))
                    {
                        <p class="small text-muted mb-3">Next Lesson: <em>@cl.NextLessonTitle</em></p>
                    }
                    <div class="d-flex align-items-center gap-3">
                        <div class="progress flex-grow-1" style="height: 10px;">
                            <div class="progress-bar" style="width: @cl.ProgressPercent%;"></div>
                        </div>
                        <span class="small fw-bold text-lumora-midnight">@cl.ProgressPercent% Completed</span>
                    </div>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a asp-controller="Student" asp-action="ContinueLecture" class="btn btn-cta btn-lg px-4">
                        <i class="bi bi-play-circle-fill me-2"></i>Resume Lecture
                    </a>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        <!-- Left Column: Enrolled Courses List -->
        <div class="col-lg-8">
            <div class="card p-4 border-lumora-subtle mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-lumora-subtle">
                    <h5 class="fw-bold mb-0 font-heading">Active Enrolled Curricula</h5>
                    <a asp-controller="Student" asp-action="MyCourses" class="small fw-semibold text-lumora-champagne-dark">View All (@Model.EnrolledCount)</a>
                </div>

                @if (!Model.Courses.Any())
                {
                    <p class="small text-muted mb-0 py-3">You are not enrolled in any course yet.</p>
                }

                @for (var i = 0; i < Model.Courses.Count; i++)
                {
                    var c = Model.Courses[i];
                    var last = i == Model.Courses.Count - 1;
                    <div class="d-flex flex-column flex-sm-row gap-3 py-3 @(last ? "" : "border-bottom border-lumora-subtle") align-items-sm-center">
                        <div class="trust-icon-box bg-lumora-midnight text-lumora-champagne rounded-3 p-3 flex-shrink-0">
                            <i class="bi bi-diagram-3-fill fs-3"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="fw-bold text-lumora-midnight mb-1 font-heading">
                                <a asp-controller="Student" asp-action="ContinueLecture">@c.Title</a>
                            </h6>
                            <div class="small text-muted mb-2">@c.CompletedLessons of @c.TotalLessons lessons</div>
                            <div class="progress" style="height: 6px; max-width: 320px;">
                                <div class="progress-bar" style="width: @c.ProgressPercent%;"></div>
                            </div>
                        </div>
                        <div class="text-sm-end">
                            <span class="small fw-bold text-lumora-midnight d-block mb-1">@c.ProgressPercent%</span>
                            <a asp-controller="Student" asp-action="ContinueLecture" class="btn btn-sm btn-outline-primary">@(c.IsCompleted ? "Review" : "Continue")</a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-4">
            <div class="card p-4 border-lumora-subtle mb-4">
                <h5 class="fw-bold text-lumora-midnight mb-3 pb-2 border-bottom border-lumora-subtle font-heading">
                    <i class="bi bi-clock-history text-lumora-champagne-dark me-2"></i>Upcoming Quizzes &amp; Labs
                </h5>

                <div class="d-flex flex-column gap-3">
                    @if (!Model.Quizzes.Any())
                    {
                        <p class="small text-muted mb-0">No quizzes available right now.</p>
                    }
                    @foreach (var q in Model.Quizzes)
                    {
                        <div class="p-3 bg-lumora-ivory rounded-3 border-lumora-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge badge-gold">QUIZ</span>
                                <small class="text-muted">Pass Mark: @q.PassingScore.ToString("0.##")%</small>
                            </div>
                            <h6 class="fw-bold text-lumora-midnight mb-1 font-heading">@q.Title</h6>
                            <p class="small text-muted mb-2">@q.CourseTitle</p>
                            <a asp-controller="Student" asp-action="Quizzes" class="btn btn-sm btn-outline-primary w-100">Start Assessment</a>
                        </div>
                    }
                </div>
            </div>

            <!-- Live Office Hours Box (static for now) -->
            <div class="card p-4 border-lumora-subtle bg-white">
                <h5 class="fw-bold text-lumora-midnight mb-2 font-heading">
                    <i class="bi bi-broadcast text-lumora-champagne-dark me-2"></i>Senior Architect Q&amp;A Hub
                </h5>
                <p class="small text-muted mb-3">
                    Join live architectural breakdown sessions and code reviews hosted directly by our practitioner faculty.
                </p>
                <div class="d-flex align-items-center gap-3 p-2 rounded-3 bg-lumora-ivory border-lumora-subtle mb-3">
                    <div class="avatar-circle avatar-circle-sm">AV</div>
                    <div class="small">
                        <div class="fw-bold text-lumora-midnight">Alex Vance &bull; Live in 3 hours</div>
                        <div class="text-muted">Topic: Multi-Region Active-Active Topologies</div>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-champagne w-100" onclick="LumoraToast('Added Live Q&A event to calendar.');">
                    <i class="bi bi-calendar-plus me-1"></i>Add to Calendar
                </button>
            </div>
        </div>
    </div>
</main>